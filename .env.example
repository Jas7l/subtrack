# Copy to .env and adjust: `cp .env.example .env`. On startup the server reads
# .env from its working directory (another file can be named with ENV_FILE).
# Variables already set in the shell or the GoLand run configuration take
# precedence over the file.

# --- HTTP layer (httpsrv.Config) ---
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# --- CORS (httpsrv.CORSConfig) ---
# Comma-separated. "*" allows any origin; otherwise exact match against
# scheme://host[:port]. The React dev server usually runs on :5173 or :3000.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_EXPOSED_HEADERS=X-Request-ID,Content-Disposition
CORS_MAX_AGE=5m

# --- Logging (logger.Config) ---
LOG_LEVEL=info  # debug | info | warn | error
# LOG_FORMAT: json | console. Empty picks console when stdout is a TTY,
# json otherwise.
LOG_FORMAT=

# --- Database (pg.Config) ---
# Required: DB_HOST, DB_USER, DB_PASSWORD, DB_NAME. The server refuses to
# start with `postgres: missing required env vars: ...` if any of the four
# is empty. The schema itself is created by hand from migrations/ (see README).
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=subtrack

# Optional - defaults shown.
DB_PORT=5432
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# --- Auth (auth.Config) ---
# Required. HMAC key for signing JWTs, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# First admin, created at startup only while the database has no active admin
# (users are created by an admin, so someone has to be first). Safe to leave
# set: once an admin exists these are ignored. Email and password go together.
BOOTSTRAP_ADMIN_EMAIL=admin@company.ru
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_NAME=Администратор

# --- Web client (web.Config) ---
# The built client (make web-build) the server serves on every path outside
# the API, so the app opens at http://localhost:8080. Relative to the working
# directory. Empty: the API only (the client then runs on Vite, make web-dev).
# A missing build is not an error: the server warns and serves the API only.
WEB_DIR=web/dist

# --- Scheduler (scheduler.Config) ---
# The first run happens at startup, then every SCHEDULER_INTERVAL (at least
# 1m). "Today" for end and payment dates is the calendar day in SCHEDULER_TZ,
# the company's zone; the Excel exports show their times in it as well.
# How many days ahead to warn is set by the admin over the API
# (/api/v1/settings/notifications), not here.
SCHEDULER_TZ=Europe/Moscow
SCHEDULER_INTERVAL=1h
